generator client {
  provider = "prisma-client-js"
}

// Operations pass 02: additive autonomous workflows; old facts keep their defaults.
model LmsApplication {
  id String @id @default(uuid())
  tenantId String
  kind String
  courseVersionId String
  actorId String?
  recipientId String?
  customerId String?
  contact Json
  quantity Int
  comment String @default("")
  state String @default("NEW")
  revision Int @default(0)
  assignedTo String?
  reason String?
  orderId String?
  operationId String?
  enrollmentId String?
  idempotencyKey String
  inputHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,id])
  @@unique([tenantId,idempotencyKey])
  @@index([tenantId,state,createdAt,id])
  @@index([tenantId,actorId,createdAt,id])
  @@index([tenantId,orderId])
}
model LmsEmployerImport {
  id String @id @default(uuid())
  tenantId String
  customerId String
  actorId String
  confirmedBy String?
  courseVersionId String
  sourceOrderId String?
  sourceRequestId String?
  groupId String?
  groupName String @default("")
  dueAt DateTime?
  state String @default("DRAFT")
  revision Int @default(0)
  input Json
  inputHash String
  operationId String?
  cursor Int @default(0)
  errorCode String?
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,id])
  @@index([tenantId,actorId,updatedAt])
  @@index([state,leaseUntil])
}
model LmsEmployerImportRow {
  id String @id @default(uuid())
  tenantId String
  importId String
  sourceRow Int
  recipientId String?
  outcome String
  errorCode String?
  @@unique([tenantId,importId,sourceRow])
}
model LmsReportJob {
  id String @id @default(uuid())
  tenantId String
  requestedBy String
  requestedRole String
  scopePolicy Json
  reportKind String
  format String
  language String
  filters Json
  requestKey String
  payloadHash String
  status String @default("PENDING")
  snapshotAt DateTime @default(now())
  totalRows Int @default(0)
  progress Int @default(0)
  attempts Int @default(0)
  runAfter DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String?
  fencingToken Int @default(0)
  errorCode String?
  storageKey String?
  sha256 String?
  size Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  @@unique([tenantId,requestedBy,requestKey])
  @@unique([tenantId,id])
  @@index([status,runAfter,leaseUntil])
}
model LmsReportRow {
  id String @id @default(uuid())
  tenantId String
  jobId String
  ordinal Int
  enrollmentId String?
  payload Json
  @@unique([jobId,ordinal])
  @@index([tenantId,jobId,enrollmentId])
}
model LmsReportScope {
  tenantId String
  jobId String
  enrollmentId String
  @@id([jobId,enrollmentId])
  @@index([tenantId,jobId])
}
model MfaFactor {
  userId String @id
  tenantId String
  secretCiphertext String?
  pendingCiphertext String?
  pendingExpiresAt DateTime?
  enabledAt DateTime?
  lastTotpStep Int @default(-1)
  updatedAt DateTime @updatedAt
  @@unique([tenantId,userId])
}
model MfaRecoveryCode {
  id String @id @default(uuid())
  tenantId String
  userId String
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId,codeHash])
}
model MfaChallenge {
  id String @id
  tenantId String
  userId String
  sessionVersion Int
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model MfaReauth {
  id String @id
  tenantId String
  userId String
  sessionId String
  purpose String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
}
model LmsNotificationEvent {
  id String @id @default(uuid())
  tenantId String
  userId String
  sourceType String
  sourceId String
  enrollmentId String?
  kind String
  deliveryKey String
  titleRu String
  titleKz String
  href String?
  state String @default("PENDING")
  attempts Int @default(0)
  runAfter DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tenantId,userId,deliveryKey])
  @@index([state,runAfter,leaseUntil])
}
model LmsNotificationCheckpoint {
  tenantId String @id
  activatedAt DateTime @default(now())
  enrollmentCursor String @default("")
  renewalCursor String @default("")
  renewalScannedAt DateTime?
  scannedAt DateTime?
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Tenant {
  id String @id @default(uuid())
  name String
  timezone String @default("Asia/Almaty")
  active Boolean @default(true)
  demoOnly Boolean @default(false)
  mfaRequiredStaff Boolean @default(false)
  learnerRegistrationEnabled Boolean?
  createdAt DateTime @default(now())
}

// Autonomous LMS. Composite foreign keys and immutability triggers live in the additive migration.
model LearnerProfile {
  id String @id @default(uuid())
  tenantId String
  userId String
  recipientId String
  consentVersion String
  consentAt DateTime
  createdAt DateTime @default(now())
  @@unique([tenantId,userId])
  @@unique([tenantId,recipientId])
  @@unique([tenantId,id])
}
model LearnerInvite {
  id String @id @default(uuid())
  tenantId String
  recipientId String
  customerId String?
  tokenHash String @unique
  email String
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([tenantId,recipientId])
}
model LearnerRecovery {
  id String @id @default(uuid())
  tenantId String
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
}
model Course {
  publicCatalogEnabled Boolean @default(false)
  publicSummaryRu String @default("")
  publicSummaryKz String @default("")
