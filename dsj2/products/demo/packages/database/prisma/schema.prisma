  assignmentPaused Boolean @default(false)
  assignmentPauseReason String?
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,archived,createdAt])
}
model RegulatoryProfileVersion {
  id String @id @default(uuid())
  tenantId String
  courseId String
  version Int
  status String @default("NEEDS_LEGAL_REVIEW")
  definition Json
  snapshotHash String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tenantId,courseId,version])
  @@unique([tenantId,id])
}
model CourseVersion {
  teachingCourse Course @relation(fields: [tenantId,courseId], references: [tenantId,id], onDelete: Restrict, onUpdate: NoAction)
  learningEnrollments Enrollment[]
  id String @id @default(uuid())
  tenantId String
  courseId String
  version Int
  status String @default("DRAFT")
  revision Int @default(0)
  content Json
  regulatoryProfileVersionId String
  snapshotHash String?
  publishedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,courseId,version])
  @@unique([tenantId,id])
  @@index([tenantId,status,createdAt])
  @@index([tenantId,courseId,version])
}
model LmsMaterial {
  id String @id @default(uuid())
  tenantId String
  courseId String
  storageKey String
  sha256 String
  size Int
  mimeType String
  originalName String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,courseId])
}
model Enrollment {
  attemptCycle String @default("INITIAL")
  groupMemberships LmsGroupMember[]
  learningVersion CourseVersion @relation(fields: [tenantId,courseVersionId], references: [tenantId,id], onDelete: Restrict, onUpdate: NoAction)
  courseGroup LmsGroup? @relation(fields: [tenantId,groupId], references: [tenantId,id], onDelete: Restrict, onUpdate: NoAction)
  id String @id @default(uuid())
  tenantId String
  courseVersionId String
  recipientId String
  learnerUserId String?
  customerId String?
  groupKey String @default("")
  groupId String?
  sourceRequestId String?
  sourceOrderId String?
  dueAtOverride Boolean @default(false)
  status String @default("ACTIVE")
  dueAt DateTime?
  startsAt DateTime?
  accessPolicy Json?
  assignedBy String
  assignedAt DateTime @default(now())
  completedAt DateTime?
  @@unique([tenantId,courseVersionId,recipientId,attemptCycle])
  @@unique([tenantId,id])
  @@index([tenantId,learnerUserId,status])
  @@index([tenantId,customerId,status])
  @@index([tenantId,assignedAt,id])
  @@index([tenantId,groupId,assignedAt,id])
  @@index([tenantId,sourceOrderId,assignedAt,id])
  @@index([tenantId,sourceRequestId])
  @@index([tenantId,dueAt,id])
}
model LmsGroup {
  members LmsGroupMember[]
  teachingBindings LmsTeachingBinding[]
  learningEnrollments Enrollment[]
  id String @id @default(uuid())
  tenantId String
  name String
  courseVersionId String
  customerId String?
  sourceRequestId String?
  sourceOrderId String?
  dueAt DateTime?
  startsAt DateTime?
