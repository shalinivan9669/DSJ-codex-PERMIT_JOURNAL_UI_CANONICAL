generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Tenant {
  id String @id @default(uuid())
  name String
  timezone String @default("Asia/Almaty")
  active Boolean @default(true)
  demoOnly Boolean @default(false)
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(uuid())
  tenantId String
  email String @unique
  displayName String
  passwordHash String
  role String @default("VIEWER")
  active Boolean @default(true)
  sessionVersion Int @default(1)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
}
model Session {
  id String @id
  tenantId String
  userId String
  csrfHash String
  sessionVersion Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model IssuerProfileVersion {
  id String @id @default(uuid())
  tenantId String
  version Int
  profile Json
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,version])
  @@unique([tenantId,id])
}
model CustomerOrganization {
  id String @id @default(uuid())
  tenantId String
  nameRu String
  nameKz String @default("")
  legalForm String?
  ownNameRu String?
  ownNameKz String?
  bin String @default("")
  addressRu String @default("")
  addressKz String @default("")
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,nameRu])
}
model Recipient {
  id String @id @default(uuid())
  tenantId String
  data Json
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
}
model PrintRequest {
  id String @id @default(uuid())
  tenantId String
  kind String
  title String @default("")
  customerId String?
  demoMode Boolean @default(false)
  status String @default("DRAFT")
  revision Int @default(0)
  draft Json
  itemCount Int @default(0)
  searchText String @default("")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  correctsIssuanceId String?
  correctionReason String?
  legacySourceId String?
  workingRevision Int @default(0)
  approvalPolicy Boolean @default(true)
  approvedProposalId String?
  archivedAt DateTime?
  @@unique([tenantId,id])
  @@unique([tenantId,legacySourceId])
  @@index([tenantId,status,createdAt])
}
model RequestItem {
  id String @id @default(uuid())
  tenantId String
  requestId String
  rowId String
  position Int
  payload Json
  @@unique([requestId,rowId])
  @@index([tenantId,requestId])
}
model TemplateVersion {
  id String @id @default(uuid())
  tenantId String
  templateId String
  version String
  checksum String
  storageKey String
  contract Json
  approved Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([tenantId,templateId,version])
  @@unique([tenantId,id])
}
model Issuance {
  id String @id @default(uuid())
  tenantId String
  requestId String
  sourceRevision Int
  snapshot Json
  inputHash String
  profileVersionId String
  createdBy String
  createdAt DateTime @default(now())
  correctsIssuanceId String?
  correctionReason String?
  legacySourceId String?
  @@unique([requestId,sourceRevision])
  @@unique([tenantId,id])
  @@unique([tenantId,legacySourceId])
}
model IssuanceEvent {
  id String @id @default(uuid())
  tenantId String
  issuanceId String
  kind String
  reason String
  actorId String
  relatedIssuanceId String?
  createdAt DateTime @default(now())
  @@index([tenantId,issuanceId])
}
model IssuedDocument {
  id String @id @default(uuid())
  tenantId String
  issuanceId String
  requestId String
  rowId String?
  assignmentId String?
  ownerKind String @default("INDIVIDUAL")
  groupEventId String?
  groupEventRevision Int?
  templateVersionId String
  templateId String
  namespace String
  number String
  registrationNumber String?
  documentDate String
  replacesDocumentId String?
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([issuanceId,rowId,assignmentId])
  @@unique([tenantId,groupEventId,groupEventRevision])
}
model TrainingEvent {
  id String @id
  tenantId String
  requestId String
  revision Int @default(0)
  title String
  protocolTemplateId String
  data Json
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,requestId])
}
model GroupDocumentMember {
  id String @id @default(uuid())
  tenantId String
  documentId String
  requestId String
  rowId String
  assignmentId String
  recipientId String?
  employerId String?
  position Int
  outcome Json
  @@unique([documentId,requestId,rowId,assignmentId])
  @@index([tenantId,recipientId])
}
model RecipientEmployment {
  id String @id @default(uuid())
  tenantId String
  recipientId String
  employerId String
  personnelNumber String @default("")
  positionRu String @default("")
  period String @default("")
  createdBy String
  createdAt DateTime @default(now())
  @@index([tenantId,recipientId])
}
model CustomerExportProfile {
  id String @id @default(uuid())
  tenantId String
  customerId String?
  name String
  profile Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,name])
  @@unique([tenantId,id])
}
model NumberSequence {
  tenantId String
  namespace String
  value Int @default(0)
  prefix String @default("")
  suffix String @default("")
  padding Int @default(5)
  policyVersion Int @default(1)
  @@id([tenantId,namespace])
}
model NumberReservation {
  id String @id @default(uuid())
  tenantId String
  namespace String
  sequence Int
  formattedNumber String
  documentId String
  createdAt DateTime @default(now())
  @@unique([tenantId,namespace,sequence])
  @@unique([tenantId,namespace,formattedNumber])
  @@index([tenantId,documentId])
}
model RenderInputSnapshot {
  id String @id @default(uuid())
  tenantId String
  requestId String
  revision Int
  issuanceId String?
  templateVersionId String?
  profileVersionId String
  input Json
  inputHash String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
}
model GenerationJob {
  id String @id @default(uuid())
  tenantId String
  requestId String
  issuanceId String?
  documentId String?
  snapshotId String
  kind String
  status String @default("PENDING")
  logicalKey String @unique
  attempts Int @default(0)
  maxAttempts Int @default(3)
  runAfter DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String?
  fencingToken Int @default(0)
  heartbeatAt DateTime?
  errorCode String?
  errorMessage String?
  correlationId String @default(uuid())
  progress Int @default(0)
  artifactId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,id])
  @@index([status,runAfter,leaseUntil])
  @@index([tenantId,requestId])
}
model Artifact {
  id String @id @default(uuid())
  tenantId String
  jobId String
  requestId String
  issuanceId String?
  documentId String?
  format String
  storageKey String @unique
  sha256 String
  size Int
  mimeType String
  fileName String
  templateVersion String?
  rendererVersion String
  inputHash String
  provenance String @default("ORIGINAL")
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,requestId])
}
model PhotoAsset {
  id String @id @default(uuid())
  tenantId String
  ownerId String
  storageKey String @unique
  originalStorageKey String
  sha256 String
  size Int
  width Int
  height Int
  mimeType String @default("image/png")
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
}
model IdempotencyOperation {
  id String @id @default(uuid())
  tenantId String
  command String
  idempotencyKey String
  payloadHash String
  result Json
  createdAt DateTime @default(now())
  @@unique([tenantId,command,idempotencyKey])
}
model ImportBatch {
  id String @id @default(uuid())
  tenantId String
  checksum String
  rows Json
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,checksum])
}
model ImportMapping {
  id String @id @default(uuid())
  tenantId String
  name String
  columns Json
  mapping Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,name])
}
model AuditEvent {
  id String @id @default(uuid())
  tenantId String
  actorId String
  action String
  entityId String
  metadata Json
  correlationId String
  createdAt DateTime @default(now())
  @@index([tenantId,createdAt])
}
model WorkerHeartbeat {
  id String @id
  seenAt DateTime @default(now())
  version String
}
model LegacyMapping {
  id String @id @default(uuid())
  tenantId String
  sourceSystem String
  sourceId String
  checksum String
  entityId String
  provenance String
  createdAt DateTime @default(now())
  @@unique([tenantId,sourceSystem,sourceId])
}
// Additive OT Center service workflow models. Integrated into schema.prisma.
model ServiceOrder {
  id String @id @default(uuid())
  tenantId String
  title String
  customerId String?
  payerId String?
  employerId String?
  contact String @default("")
  ownerId String?
  dueDate String?
  status String @default("OPEN")
  revision Int @default(0)
  commercial Json @default("{}")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,id])
  @@index([tenantId,status,createdAt])
  @@index([tenantId,employerId])
}
model ServiceOrderRequest {
  id String @id @default(uuid())
  tenantId String
  orderId String
  requestId String
  @@unique([tenantId,orderId,requestId])
  @@index([tenantId,requestId])
}
model OrderMilestone {
  id String @id @default(uuid())
  tenantId String
  orderId String
  label String
  category String
  source String
  sourceReference String
  ownerId String?
  dueDate String?
  status String @default("PENDING")
  evidence String @default("")
  reason String @default("")
  completedBy String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,orderId,status])
}
model RenewalNeed {
  id String @id @default(uuid())
  tenantId String
  customerId String?
  recipientId String?
  sourceRequestId String
  sourceRowId String
  assignmentId String
  sourceKey String
  policySource String
  policyVersion String
  basisDate String
  documentValidUntil String?
  nextCheckDate String?
  contactAfter String?
  confirmed Boolean @default(false)
  state String @default("NEEDS_REVIEW")
  reason String @default("")
  ownerId String?
  newRequestId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,id])
  @@unique([tenantId,sourceKey])
  @@index([tenantId,state,contactAfter])
}
model RenewalContact {
  id String @id @default(uuid())
  tenantId String
  renewalId String
  occurredOn String
  channel String
  outcome String
  note String
  actorId String
  createdAt DateTime @default(now())
  @@index([tenantId,renewalId])
}
model ExternalEvidence {
  id String @id @default(uuid())
  tenantId String
  customerId String
  recipientId String
  program String
  issuer String
  originalNumber String
  documentDate String
  validUntil String?
  source String
  status String @default("UNVERIFIED")
  verificationNote String @default("")
  verifiedBy String?
  verifiedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,customerId,recipientId])
}
model ServiceRuleVersion {
  id String @id @default(uuid())
  tenantId String
  serviceKey String
  version Int
  title String
  status String @default("DRAFT")
  source String
  applicability String
  checkedOn String?
  checkedBy String?
  effectiveFrom String?
  effectiveTo String?
  definition Json
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,serviceKey,version])
}
model DossierRecord {
  id String @id @default(uuid())
  tenantId String
  title String
  category String
  version String
  source String
  applicability String
  validUntil String?
  ownerId String
  customerVisible Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,category])
}
model EmployerMembership {
  id String @id @default(uuid())
  tenantId String
  customerId String
  userId String
  permissions Json
  recipientIds Json @default("[]")
  active Boolean @default(true)
  expiresAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,customerId,userId])
}
model EmployerInvite {
  id String @id @default(uuid())
  tenantId String
  customerId String
  email String
  displayName String
  secretHash String @unique
  existingUserId String?
  userSessionVersion Int?
  permissions Json
  recipientIds Json @default("[]")
  accessExpiresAt DateTime
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  membershipId String?
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,createdAt])
}
model PortalProposal {
  id String @id @default(uuid())
  tenantId String
  orderId String
  requestId String
  membershipId String
  requestRevision Int
  kind String
  message String
  changes Json
  status String @default("PENDING")
  resolution String @default("")
  resolvedBy String?
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,orderId,status])
}
model PaymentEvent {
  id String @id @default(uuid())
  tenantId String
  orderId String
  amountMinor String
  occurredOn String
  source String
  reconciliationRequired Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  @@index([tenantId,orderId])
}
model FinancialDocument {
  id String @id @default(uuid())
  tenantId String
  orderId String
  type String
  number String
  documentDate String
  source String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,type,number])
}
model ValueAttachment {
  id String @id @default(uuid())
  tenantId String
  orderId String?
  eventId String?
  evidenceId String?
  dossierId String?
  financialDocumentId String?
  category String
  source String
  fileName String
  mimeType String
  storageKey String @unique
  sha256 String
  size Int
  customerVisible Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,eventId])
}
// Source fragment for integration into the canonical schema by the root agent.
model PublicDocumentVerification {
  id String @id @default(uuid())
  tenantId String
  documentId String
  tokenHash String @unique
  active Boolean @default(true)
  expiresAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,documentId])
}
model DocumentCorrectionRequest {
  id String @id @default(uuid())
  tenantId String
  verificationId String
  message String
  replyContact String @default("")
  status String @default("NEW")
  resolution String @default("")
  resolvedBy String?
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,status,createdAt])
}

model RequestProposal {
  id String @id @default(uuid())
  tenantId String
  requestId String
  revision Int
  baseRevision Int
  operation String @default("SAVE")
  payload Json
  before Json
  diff Json
  proposalHash String
  status String @default("PENDING")
  submittedBy String
  submittedAt DateTime @default(now())
  reason String @default("")
  @@unique([tenantId,id])
  @@unique([requestId,revision])
  @@index([tenantId,status,submittedAt])
}
model ProposalDecision {
  id String @id @default(uuid())
  tenantId String
  proposalId String
  decision String
  comment String
  proposalHash String
  decidedBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,proposalId])
}
model IssuanceWorkflow {
  id String @id @default(uuid())
  tenantId String
  requestId String
  issuanceId String
  proposalId String
  status String @default("RENDERING")
  requiredSigners Json
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tenantId,issuanceId])
  @@unique([tenantId,id])
}
model SignatoryBinding {
  id String @id @default(uuid())
  tenantId String
  userId String
  iin String
  bin String?
  displayName String
  kind String
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,userId,active])
}
model SigningSession {
  id String @id @default(uuid())
  tenantId String
  issuanceId String
  artifactId String
  bindingId String
  provider String
  providerReference String?
  documentSha256 String
  inputHash String
  status String @default("PENDING")
  createdBy String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
}
model DocumentSignature {
  id String @id @default(uuid())
  tenantId String
  issuanceId String
  artifactId String
  bindingId String
  signingSessionId String @unique
  documentSha256 String
  signatureSha256 String
  signatureStorageKey String @unique
  signerIin String
  signerBin String?
  certificateSerial String
  certificateFingerprint String
  provider String
  verification Json
  createdBy String
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,artifactId,bindingId])
}
