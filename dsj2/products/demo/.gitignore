# Logs and generated acceptance output are local.
*.log
*.out
*.err

# Keep only the maintained progress record and requirement matrix in Git.
# Screenshots, rendered documents, per-run JSON/CSV, logs, scans and temporary
# audit helpers stay on disk. Reusable test sources belong in tests/ or scripts/.
# Source templates, fonts, licenses and test fixtures are not covered here.
/docs/evidence/*
!/docs/evidence/neutral-forms-20261005/
!/docs/evidence/progress.md
!/docs/evidence/commercial-acceptance/
/docs/evidence/commercial-acceptance/*
!/docs/evidence/commercial-acceptance/matrix.json

# Maintained OT Center V2 requirements and release record only.
# Raw runs, logs, screenshots, databases and generated documents stay local.
!/docs/evidence/operator-value/
/docs/evidence/operator-value/*
!/docs/evidence/operator-value/Plan.md
!/docs/evidence/operator-value/Decisions.md
!/docs/evidence/operator-value/Progress.md
!/docs/evidence/operator-value/Verification.md
!/docs/evidence/operator-value/acceptance-matrix.json
!/docs/evidence/operator-value/feature-matrix.json
!/docs/evidence/operator-value/business-scenarios.json
!/docs/evidence/operator-value/business-value-map.json
!/docs/evidence/operator-value/release-checks.json

# Maintained UX acceptance and preservation records are source-controlled.
# Keep raw runs in the same directories local.
!/docs/evidence/forms-ux/
/docs/evidence/forms-ux/*
!/docs/evidence/forms-ux/acceptance-matrix.json
!/docs/evidence/forms-ux/preservation.json
!/docs/evidence/forms-ux/source-isolation-final.json
!/docs/evidence/ot-center-dsj-forms-ux/
/docs/evidence/ot-center-dsj-forms-ux/*
!/docs/evidence/ot-center-dsj-forms-ux/date-rule-evidence.md
!/docs/evidence/feedback-ux-20260929/
/docs/evidence/feedback-ux-20260929/*
!/docs/evidence/feedback-ux-20260929/acceptance-matrix.json
!/docs/evidence/feedback-answers-20260929/
/docs/evidence/feedback-answers-20260929/*
!/docs/evidence/feedback-answers-20260929/acceptance-matrix.json

# Delivery archives and their generated manifests are local output.
/docs/deliverables/*
!/docs/deliverables/README.md

