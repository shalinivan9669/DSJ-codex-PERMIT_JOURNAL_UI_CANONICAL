DATABASE_URL=postgresql://demo:CHANGE_ME@127.0.0.1:5432/demo
DEMO_ORIGIN=http://localhost:3100
DEMO_API_ORIGIN=http://127.0.0.1:4100
DEMO_ARTIFACT_ROOT=./data/artifacts
DEMO_PYTHON=python3
DEMO_SOFFICE=soffice
# Set only for explicit initial provisioning; no default administrator password.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_TENANT_NAME=
DEMO_SAMPLE_DATA=0
# Optional automatic suggestions for job titles and training programs only.
# Suggestions require operator review before they become document fields.
DEMO_GOOGLE_TRANSLATE_API_KEY=

# Official signing bridges. Leave empty until authorized external services are configured.
# See docs/SIGNING_CONNECTION_RU.md for the adapter contract and connection checks.
DEMO_EGOV_SIGNING_CONNECTOR_URL=
DEMO_EGOV_SIGNING_CONNECTOR_TOKEN=
DEMO_SIGNATURE_VERIFIER_URL=
DEMO_SIGNATURE_VERIFIER_TOKEN=
# Local NCALayer rehearsal only: development/test, loopback URLs + demo_test_* DB,
# demoOnly tenant and demoMode request. Does not verify CMS identity/NCA trust.
DEMO_LOCAL_SIGNATURE_MOCK=0
# Hosted NCALayer rehearsal only: NODE_ENV=production/test, clean public HTTPS
# DEMO_ORIGIN + DEMO_API_ORIGIN, one exact demoOnly tenant, demoMode request.
# Provision the separate tenant first; paste its UUID, never a wildcard/list.
# No CMS cryptographic/identity/NCA verification; official signing stays separate.
# See deployment/railway/HOSTED_NCALAYER_TEST_RU.md. Both modes default to off.
DEMO_HOSTED_SIGNATURE_MOCK=0
DEMO_HOSTED_SIGNATURE_MOCK_TENANT_ID=
