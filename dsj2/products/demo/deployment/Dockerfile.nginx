# Keep the base reproducible, then include current security fixes from its Alpine branch.
# The resulting package inventory and digest are recorded by the image acceptance scan.
FROM nginx:1.30.5-alpine@sha256:ef8676b33d681f272ba429b27658bdd7e640963279714c96bddf1dc76307f7b6
USER root
RUN apk upgrade --no-cache
USER 101:101
