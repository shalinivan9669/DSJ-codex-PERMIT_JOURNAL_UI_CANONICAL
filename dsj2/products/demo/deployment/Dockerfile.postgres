# PostgreSQL's optional SQL/XML support is deliberately absent: DEMO uses JSONB,
# text, dates and relational types. No existing database volume is converted.
# Source SHA is published by PostgreSQL and the official postgres image recipe.
FROM postgres:18.6-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873 AS entrypoint
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS build
ARG PG_VERSION=18.6
ARG PG_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f
ARG MAKE_JOBS=4
RUN apk upgrade --no-cache \
    && apk add --no-cache build-base bison flex icu-dev openssl-dev libedit-dev \
        zlib-dev lz4-dev zstd-dev linux-headers curl bzip2
RUN curl --fail --location --retry 3 "https://ftp.postgresql.org/pub/source/v${PG_VERSION}/postgresql-${PG_VERSION}.tar.bz2" -o /tmp/postgresql.tar.bz2 \
    && echo "${PG_SHA256}  /tmp/postgresql.tar.bz2" | sha256sum -c - \
    && mkdir /src && tar -xjf /tmp/postgresql.tar.bz2 --strip-components=1 -C /src
WORKDIR /src
RUN apk add --no-cache perl
# Match the official entrypoint's socket path; all feature selection uses standard
# upstream configure switches, with no shared-library or SONAME substitutions.
RUN sed -i 's|^#define[[:space:]]*DEFAULT_PGSOCKET_DIR[[:space:]]*"/tmp"|#define DEFAULT_PGSOCKET_DIR "/var/run/postgresql"|' src/include/pg_config_manual.h \
    && grep -F '"/var/run/postgresql"' src/include/pg_config_manual.h \
    && ./configure --enable-option-checking=fatal --prefix=/usr/local --disable-rpath \
        --with-pgport=5432 --with-system-tzdata=/usr/share/zoneinfo \
        --with-icu --with-ssl=openssl --with-libedit-preferred --with-lz4 --with-zstd \
        --without-libxml --without-libxslt \
    && make -j "${MAKE_JOBS}" world-bin \
    && make install-world-bin \
    && install -D -m 644 COPYRIGHT /usr/local/share/licenses/postgresql/COPYRIGHT
# The upstream regression suite must run as an unprivileged user.
RUN apk add --no-cache tzdata icu-data-full
RUN adduser -D pgbuild && chown -R pgbuild:pgbuild /src
USER pgbuild
RUN make check

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --from=build /usr/local/ /usr/local/
RUN apk upgrade --no-cache \
    && apk add --no-cache --virtual .scan-deps pax-utils \
    && runDeps="$(scanelf --needed --nobanner --format '%n#p' --recursive /usr/local | tr ',' '\n' | sort -u | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }')" \
    && apk add --no-cache --virtual .postgresql-rundeps ${runDeps} bash tzdata zstd icu-data-full ca-certificates \
    && apk del --no-network .scan-deps \
    && addgroup -g 70 -S postgres \
    && adduser -u 70 -S -D -G postgres -H -h /var/lib/postgresql -s /bin/sh postgres \
    && mkdir -p /var/lib/postgresql /var/run/postgresql /docker-entrypoint-initdb.d \
    && chown postgres:postgres /var/lib/postgresql /var/run/postgresql \
    && chmod 1777 /var/lib/postgresql && chmod 3777 /var/run/postgresql \
    && sed -i "s/^#listen_addresses = 'localhost'/listen_addresses = '*'/" /usr/local/share/postgresql/postgresql.conf.sample \
    && test "$(postgres --version)" = "postgres (PostgreSQL) 18.6" \
    && ! apk info --installed libxml2 \
    && ! ldd /usr/local/bin/postgres | grep -E 'libxml|libxslt'
COPY --from=entrypoint /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-ensure-initdb.sh /usr/local/bin/
RUN ln -s docker-ensure-initdb.sh /usr/local/bin/docker-enforce-initdb.sh
ENV LANG=en_US.utf8 PG_MAJOR=18 PG_VERSION=18.6 PGDATA=/var/lib/postgresql/18/docker
VOLUME /var/lib/postgresql
USER postgres
STOPSIGNAL SIGINT
EXPOSE 5432
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
